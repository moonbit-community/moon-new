import {
  "moonbit-community/liquid",
  "moonbit-community/moon-new/repository",
  "mizchi/bit_lib" @git,
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

rule(
  name: "asset_00",
  command: ":embed --text --name asset_00 --input $input --output $output",
)

dev_build(
  rule: "asset_00",
  input: "assets/moon.pkg",
  output: "asset_00.generated.mbt",
)

