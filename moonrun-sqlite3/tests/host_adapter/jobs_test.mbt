///|
test "native jobs transfer handles and preserve step snapshots" {
  let code = Ref(0)
  let executor = @ffi.sqlite3_executor_create(code)
  assert_eq(code.val, 0)
  defer @ffi.sqlite3_executor_release(executor)
  let open = @ffi.sqlite3_open_job(executor, b":memory:", 0x10006, code)
  defer open.release()
  assert_eq(code.val, 0)
  open.wait()
  assert_eq(open.result(), (0, 0, ""))
  let database = open.take_database()
  defer @ffi.sqlite3_close(database) |> ignore
  let prepare = @ffi.sqlite3_prepare_job(executor, database, "SELECT 42", code)
  defer prepare.release()
  assert_eq(code.val, 0)
  prepare.wait()
  assert_eq(prepare.result(), (0, 0, "", 9))
  let statement = prepare.take_statement()
  defer @ffi.sqlite3_finalize(statement) |> ignore
  let row = @ffi.sqlite3_step_job(executor, database, statement, code)
  defer row.release()
  assert_eq(code.val, 0)
  row.wait()
  assert_eq(row.result(), (100, 100, "", None))
  assert_eq(@ffi.sqlite3_column_int64(statement, 0), 42L)
  let done = @ffi.sqlite3_step_job(executor, database, statement, code)
  defer done.release()
  assert_eq(code.val, 0)
  done.wait()
  assert_eq(done.result(), (101, 101, "", None))
  assert_eq(row.result(), (100, 100, "", None))
}

///|
test "native jobs discard unclaimed results and retain diagnostics" {
  let code = Ref(0)
  let executor = @ffi.sqlite3_executor_create(code)
  assert_eq(code.val, 0)
  defer @ffi.sqlite3_executor_release(executor)
  let discarded = @ffi.sqlite3_open_job(executor, b":memory:", 0x10006, code)
  defer discarded.release()
  assert_eq(code.val, 0)
  discarded.wait()
  assert_eq(discarded.result(), (0, 0, ""))
  discarded.discard()
  assert_eq(discarded.result(), (0, 0, ""))
  let database = open_database()
  defer @ffi.sqlite3_close(database) |> ignore
  let prepared = @ffi.sqlite3_prepare_job(executor, database, "SELECT 1", code)
  defer prepared.release()
  assert_eq(code.val, 0)
  prepared.wait()
  assert_eq(prepared.result(), (0, 0, "", 8))
  prepared.discard()
  assert_eq(prepared.result(), (0, 0, "", 8))
  let failed = @ffi.sqlite3_prepare_job(executor, database, "SELECT FROM", code)
  defer failed.release()
  assert_eq(code.val, 0)
  failed.wait()
  let snapshot = failed.result()
  assert_eq(snapshot.0, 1)
  assert_eq(snapshot.1, 1)
  assert_true(!snapshot.2.is_empty())
  assert_eq(snapshot.3, -1)
  let tail = Ref(0)
  let statement = @ffi.sqlite3_prepare16_v2(database, "SELECT 2", tail, code)
  defer @ffi.sqlite3_finalize(statement) |> ignore
  assert_eq(code.val, 0)
  assert_eq(@ffi.sqlite3_step(statement), 100)
  assert_eq(failed.result(), snapshot)
}
